40" /></navPoint><navPoint id="navpoint-215" playOrder="216"><navLabel><text>Disorders of Epidermal Appendages</text></navLabel><content src="xhtml/B978032353113900025X.xhtml#s0405" /></navPoint><navPoint id="navpoint-216" playOrder="217"><navLabel><text>Panniculitis</text></navLabel><content src="xhtml/B978032353113900025X.xhtml#s0440" /></navPoint><navPoint id="navpoint-217" playOrder="218"><navLabel><text>Infection</text></navLabel><content src="xhtml/B978032353113900025X.xhtml#s0455" /></navPoint></navPoint><navPoint id="navpoint-218" playOrder="219"><navLabel><text>Chapter 26: Bones, Joints, and Soft Tissue Tumors</text></navLabel><content src="xhtml/B9780323531139000261.xhtml" /><navPoint id="navpoint-219" playOrder="220"><navLabel><text>Bone</text></navLabel><content src="xhtml/B9780323531139000261.xhtml#s0010" /></navPoint><navPoint id="navpoint-220" playOrder="221"><navLabel><text>Joints</text></navLabel><content src="xhtml/B9780323531139000261.xhtml#s0390" /></navPoint><navPoint id="navpoint-221" playOrder="222"><navLabel><text>Soft Tissue Tumors</text></navLabel><content src="xhtml/B9780323531139000261.xhtml#s0565" /></navPoint></navPoint><navPoint id="navpoint-222" playOrder="223"><navLabel><text>Chapter 27: Peripheral Nerves and Skeletal Muscles</text></navLabel><content src="xhtml/B9780323531139000273.xhtml" /><navPoint id="navpoint-223" playOrder="224"><navLabel><text>Diseases of Peripheral Nerves</text></navLabel><content src="xhtml/B9780323531139000273.xhtml#s0010" /></navPoint><navPoint id="navpoint-224" playOrder="225"><navLabel><text>Diseases of the Neuromuscular Junction</text></navLabel><content src="xhtml/B9780323531139000273.xhtml#s0175" /></navPoint><navPoint id="navpoint-225" playOrder="226"><navLabel><text>Diseases of Skeletal Muscle</text></navLabel><content src="xhtml/B9780323531139000273.xhtml#s0215" /></navPoint><navPoint id="navpoint-226" playOrder="227"><navLabel><text>Peripheral Nerve S